# Model files (large trained models - but allow essential project files)
*.h5
*.hdf5
*.joblib

# Allow essential project data files
!data/extracted_entities.pkl
!data/extracted_relations.pkl
!data/normalized_entities.pkl
!data/rag_vector_store.pkl
!data/rag_processed_documents.pkl
!data/processed_chunks.pkl

# Ignore other pickle files that aren't essential
data/*sample*.pkl
data/*backup*.pkl

# Data files - keep essential files for project functionality
# Raw PDFs are large and not needed for deployment
data/raw_pdfs/*.pdf
data/samples/

# Keep processed text chunks but ignore original large text files
data/processed_texts/*.txt
!data/processed_texts/chunks/